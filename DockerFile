# -----------------------------
# Stage 1: Dependencies install
# -----------------------------
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
# Skip postinstall script since we install Chromium manually via Alpine
RUN npm install --omit=dev --legacy-peer-deps --ignore-scripts

# -----------------------------
# Stage 2: Copy and run
# -----------------------------
FROM node:20-alpine
WORKDIR /app

# Install system dependencies for Playwright/Puppeteer
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    && rm -rf /var/cache/apk/*

# Set environment variables for Playwright/Puppeteer to use system Chromium
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Use non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
USER appuser

EXPOSE 5000
CMD ["node", "server.js"]