# Use official Node image
FROM node:20-slim

# Set working directory
WORKDIR /app

# Install dependencies needed by Playwright/Chromium
RUN apt-get update && apt-get install -y \
    wget \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libgbm1 \
    libnss3 \
    libxshmfence1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy package.json and install Node dependencies
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Install Playwright and download required browsers
RUN npx playwright install --with-deps

# Copy the rest of your app
COPY . .

# Expose port if needed
EXPOSE 3000

# Start your app
CMD ["node", "server.js"]
